argument:: numBins
See the kr argument of the same name.

returns::
[beatTrigger, subdivisionTrigger, BPM, phase0to1, confidence].

examples::
AutoTrack2 provides automatic causal beat and subdivision tracking with phase continuity locking. In this example, it drives an adaptive acoustic click-track resynthesizer: beat triggers generate resonant woodblock pings locking onto acoustic drum downbeats, demonstrating reliable tempo synchronization. An interactive code::MIR2GUI.rhythm:: displays the real-time beat radar and tempo readout.
code::
(
Routine({
    var path = MIR2GUI.soundPath("drums.wav");
    ~mir2Buffer = if(path.notNil) { Buffer.read(s, path) } { nil };
    ~mir2Bus = Bus.control(s, 2);
    s.sync;
    ~mir2Example = {
        var source = PlayBuf.ar(1, ~mir2Buffer, BufRateScale.kr(~mir2Buffer), loop: 1);
        // For live input instead: source = SoundIn.ar(0);

        var chain = FFT(LocalBuf(1024), source, 0.25);
        var track = AutoTrack2.kr(chain, minBPM: 60, maxBPM: 180, fftSize: 1024, hop: 0.25);
        var beatTrig = track[0];
        var subTrig = track[1];
        var bpm = track[2];
        var conf = track[4];

        // Resonant woodblock click on downbeats
        var click = Ringz.ar(Decay2.ar(K2A.ar(beatTrig), 0.001, 0.02) * 0.1, 1200, 0.04);
        var sound = (source * 0.25) + click;

        if(~mir2Bus.notNil) { Out.kr(~mir2Bus, [bpm, conf]) };
        sound * Line.kr(0, 1, 0.2) ! 2
    }.play;

    ~mir2GUI = MIR2GUI.rhythm("AutoTrack 2", ~mir2Bus);
}).play(AppClock);
)
::
code::
(
~mir2Example.free;
if(~mir2GUI.notNil) { ~mir2GUI.close };
if(~mir2Bus.notNil) { ~mir2Bus.free };
if(~mir2Buffer.notNil) { ~mir2Buffer.free };
)
::

